# Slack app credentials — https://api.slack.com/apps → your app → Basic Information / OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Neon Postgres pooled connection string (Vercel Marketplace → Neon, or console.neon.tech)
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: set to "off" to exercise the route with a fake bot token (see docs/LOCAL_DEV.md)
SLACK_TOKEN_VERIFICATION=

# Optional: local dev tunnel for `pnpm dev:tunnel` — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=
