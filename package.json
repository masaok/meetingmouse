{
  "name": "meetingmouse",
  "version": "0.8.0",
  "description": "Slack availability polls that live in one channel message. The app, and the library a host embeds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masaok/meetingmouse.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./slack": {
      "types": "./dist/slack/index.d.ts",
      "default": "./dist/slack/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "dev:tunnel": "tsx scripts/dev.tunnel.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm docs:check && pnpm featuremap:check && pnpm prose:check && pnpm smoke && pnpm build && pnpm pack:check && pnpm smoke:pack",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "slack:sign": "tsx scripts/slack-sign.ts",
    "render:fixture": "tsx --conditions=react-server scripts/render-fixture.ts",
    "grid:preview": "tsx --conditions=react-server scripts/grid-preview.ts",
    "prepare": "husky",
    "lint:fix": "eslint --fix",
    "smoke": "tsx --conditions=react-server scripts/smoke-imports.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "featuremap:check": "tsx scripts/check-feature-map.ts",
    "predev": "tsx scripts/check-dev-env.ts",
    "health": "tsx scripts/doctor.ts",
    "prose:check": "tsx scripts/check-prose.ts",
    "build:lib": "tsdown",
    "pack:check": "tsx scripts/pack-lib.ts --dry-run | tsx scripts/check-pack.ts",
    "smoke:pack": "bash scripts/smoke-pack.sh",
    "pack:lib": "tsx scripts/pack-lib.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,json,md,yml,yaml,css}": "prettier --write"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@slack/bolt": "^5.1.0",
    "@slack/types": "^3.1.0",
    "@slack/web-api": "^8.1.1",
    "@vercel/slack-bolt": "^1.7.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@ngrok/ngrok": "^1.7.0",
    "@slack/cli-hooks": "^2.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
